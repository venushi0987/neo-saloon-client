// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  email String @unique
  phone String? @unique
  firstName String
  lastName String
  password String
  role String @default("CUSTOMER")
  status String @default("ACTIVE") // ACTIVE, BANNED, SUSPENDED
  createdAt DateTime @default(now())
  lastLogin DateTime?
  privileges String[] @default([])//  "users:add",  "users:edit",  "users.read"
  profileImage String @default("/images/default-profile.png")
} //gender, emailVerified, phoneVerified

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model Product{
  id String @id @default(uuid())
  sku String @unique
  name String
  altNames String[] @default([])
  description String
  stock Int @default(0)
  // status String @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  status ProductStatus @default(ACTIVE)
  price Float
  compareAt Float?
  brand String?
  model String?
  media Media[]
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media{
  id String @id @default(uuid())
  url String 
  type MediaType
  productId String
  product Product @relation(fields : [productId], references: [id])
}