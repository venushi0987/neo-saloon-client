// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  email String @unique
  phone String? @unique
  firstName String
  lastName String
  password String
  role String @default("CUSTOMER")
  status String @default("ACTIVE") // ACTIVE, BANNED, SUSPENDED
  createdAt DateTime @default(now())
  lastLogin DateTime?
  privileges String[] @default([])//  "users:add",  "users:edit",  "users.read"
  profileImage String @default("/images/default-profile.png")
  orders Order[]
  paymentsMade Payment[] @relation("PaymentPaidBy")
  paymentsReviewed Payment[] @relation("PaymentReviewedBy")
} //gender, emailVerified, phoneVerified

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model Product{
  id String @id @default(uuid())
  sku String @unique
  name String
  altNames String[] @default([])
  description String
  stock Int @default(0)
  // status String @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  status ProductStatus @default(ACTIVE)
  price Float
  compareAt Float?
  brand String?
  model String?
  media Media[]
  orderItems OrderItem[]
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media{
  id String @id @default(uuid())
  url String 
  type MediaType
  productId String?
  product Product? @relation(fields : [productId], references: [id])
  serviceId String?
  service Service? @relation(fields : [serviceId], references: [id])
  variantId String?
  variant Variant? @relation(fields : [variantId], references: [id])

}

enum OrderDeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED
  RETURNED
}

model Order{
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  deliveredStatus OrderDeliveryStatus @default(PENDING)
  placedByUserId String
  placedBy User @relation(fields: [placedByUserId], references: [id])
  payment Payment?
  totalAmount Decimal//Derived Attribute

  orderItems OrderItem[]
  notes String?

  orderTotalAdjustments OrderTotalAdjustment[]
}

model OrderItem{
  id String @id @default(uuid())
  orderId Int
  productId String
  name String
  price Decimal
  compareAt Decimal?
  quantity Int
  
  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model OrderTotalAdjustment{

  id String @id @default(uuid())
  orderId Int
  description String
  amount Decimal

  order Order @relation(fields: [orderId], references: [id])
}



enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentMethod{
  CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
  CASH
}

model Payment{

  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  amount Decimal
  orderId Int? @unique
  reference String? @unique
  
  status PaymentStatus @default(PENDING)
  paidByUserId String?
  reviewedByUserId String?

  method PaymentMethod @default(CARD)
  fee Decimal @default(0.00)
  createdAt DateTime @default(now())
  receivedAt DateTime?
  
  order Order? @relation(fields: [orderId], references: [id])
  paidBy User? @relation("PaymentPaidBy", fields: [paidByUserId], references: [id])
  reviewedBy User? @relation("PaymentReviewedBy", fields: [reviewedByUserId], references: [id])
}

enum ServiceCategory{
  HAIR
  NAILS
  SKIN
  MASSAGE
  MALE
  FEMALE
  WEDDING
}

enum ServiceStatus{
  ACTIVE
  INACTIVE
  DISCONTINUED
}
model Service{
  id String @id @default(uuid())
  name String
  description String
  price Decimal
  estimatedTimeInMinutes Int
  categories ServiceCategory[]
  status ServiceStatus @default(ACTIVE)
  variants Variant[]
  priorConsultationRequired Boolean @default(false)
  media Media[]
}

model Variant{
  id String @id @default(uuid())
  name String
  priorConsultationRequired Boolean @default(false)
  media Media[]
  price Decimal
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
}